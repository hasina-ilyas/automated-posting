# Telegram Bot API — https://core.telegram.org/bots/api
# 1. Create a bot via @BotFather and copy the token
# 2. Add the bot to a channel/group (or use your user chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Incoming Webhook — https://discord.com/developers/docs/resources/webhook
# Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Mastodon — https://docs.joinmastodon.org/client/token/
# Create an app under Preferences → Development and copy the access token
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Dev.to — https://dev.to/settings/extensions
# Generate an API key under Settings → Extensions → DEV Community API Keys
DEVTO_API_KEY=

# Bluesky — https://bsky.app/settings/app-passwords
# Create an app password (do not use your main account password)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social
